define fit_Cond_waterice(0,6) {

  if ($ARGC !=6) {
    printf("\n Returns the conductivity of ice computed with the models from Ferrari and al 2016 \n")
    printf("$1: Minimum Temperature [K] \n")
    printf("$2: Maximum Temperature [K] \n")
    printf("$3: Grain Radius [m] \n")
    printf("$4: Porosity \n")
    printf("$5: Model used. Must be one of the folollowing string: 'GJKRBB', 'GB','WBB','WGB' \n")
    printf("$6: Form of the ice. Must be one of the folollowing string: 'Amorphous', 'Crystalline' \n")

    printf("L.Lange 08-05-2020\n\n")

    return(null)
  }
  Tmin = double($1)
  Tmax = double($2)
  Radius = double($3)
  Porosity = double($4)
  Model = $5;
  Form = $6

  It = create2(Tmin,1,Tmax)
  xt = ( It - 220 ) * 0.01
  

  
  Condice_true = ComputeConductivity(It,Radius,Porosity,Model,Form)

  fit=fit(y=Condice_true,x=xt,type="cube",plot=0,step=10)
  out = fit

 if(out[1]<0){
    fit=fit(y=Condice_true,x=xt,type="quad",plot=0,step=10)
    out[1] = fit[1]
    out[2] = fit[2]
    out[3] = fit[3]
    out[4] = 0
 }
  return(out[:4,,])
}





define fit_Cp_waterice(0,2) {
 if ($ARGC != 2) {
    printf("\nReturns a third order fit of the specific heat of water ice\n")
    printf("\nBased on the work of  Shulman (2004)\n")
    printf("L.Lange 04-22-2025\n\n")
    printf("\nTo run, this function needs the minimun and maximum temperatures of the domain where C needs to be fitted\n")
    return(null)
  }
  Tmin = double($1)
  Tmax = double($2)
  It = create2(Tmin,1,Tmax)
  xt = ( It - 220 ) * 0.01
  
  Cice_true = Cp_ice_water(It)
  fit=fit(y=Cice_true,x=xt,type="cube",plot=0,step=10)

  return(fit)
}


define Cp_ice_water(0,1) {

  if ($ARGC != 1) {
    printf("\nReturns the specific heat of water ice\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
     pi = 3.141592653589793
  }
  intd = dim(outp)

# Element-by-element 

for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {

          intx = float(1)*outp[inti, intj, intk]
          C_T = 7.73*intx*(1-exp(-1.263*1e-3*intx^2))*(1+8.47*1e-3*intx^6*exp(-3*sqrt(intx)) + 2.0825*1e-7*intx^4*exp(-4.97*1e-2*intx))
          outp[inti, intj, intk] = C_T
        }
      }
    }

           return(outp[:4,,])
}











define ComputeConductivity(0,5){


  if ($ARGC != 5) {
    printf("\n Returns the conductivity of ice computed with the models from Ferrari and al 2016 \n")
    printf("$1: Temperature [K] \n")
    printf("$2: Grain Radius [m] \n")
    printf("$3: Porosity \n")
    printf("$4: Model used. Must be one of the folollowing string: 'GJKRBB', 'GB','WBB','WGB' \n")
    printf("$5: Form of the ice. Must be one of the folollowing string: 'Amorphous', 'Crystalline' \n")

    printf("L.Lange 08-05-2020\n\n")

    return(null)
  }




  Temp = double($1)
  Radius = double($2)
  Porosity = double($3)
  Model = $4;
  Form = $5


if(type(Model) != "STRING"){
    printf(" $4 must be a string \n")
    return(null)
    }


if(type(Form) != "STRING"){
    printf(" $5 must be a string \n")
    return(null)
    }

if(((Model == "GJKRBB") || (Model == "GB") || (Model == "WBB") || (Model == "WGB")) ==0){
printf("\n Invalid name of model \n")
printf("\n")
printf("Must be one of the folollowing string: 'GJKRBB', 'GB','WBB','WGB \n")
return(null)
}

if(((Form == "Crystalline") || (Form == "Amorphous")) == 0){
printf("\n Invalid name of form \n")
printf("\n")
printf("Must be one of the folollowing string: 'Amorphous', 'Crystalline' \n ")
return(null)
}


  if(Form == "Crystalline"){
    flagstructCryst = 1
  } else{
    flagstructCryst = 0
  }



    if(Model == "GJKRBB"){

    if(flagstructCryst == 1){
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,1,2,1,1)
    } else{
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,1,2,1,2)
    }
    }

    if(Model == "GB"){

    if(flagstructCryst == 1){
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,2,1,2,1)
    } else{
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,2,1,2,2)
    }
    }


    if(Model == "WBB"){

    if(flagstructCryst == 1){
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,3,3,1,1)
    } else{
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,3,3,1,2)
    }
    }


    if(Model == "WGB"){

    if(flagstructCryst == 1){
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,3,3,2,1)
    } else{
    conductivity =  K_E_T(Temp,Radius,Porosity,0.076,0.33,0.41,1,3,3,2,2)
    }
    }



    return(conductivity)

    }










## following computes model from the article
#Low thermal inertias of icy planetary surfaces Evidence for amorphous ice
# C.Ferrari and A.Lucas





define h_JKR_R(0,4) {

  if ($ARGC != 4) {
    printf("\nReturns the Hertz factor with JKR model. Variable is the grain size\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
     pi = 3.141592653589793
  }

  if (type($2) == "double") {
    gamma = double($2)
  } else {
    gamma = float($2)
  }

  if (type($3) == "double") {
    mu = double($3)
  } else {
    mu = float($3)
  }
  if (type($4) == "double") {
    T = double($4)
  } else {
    T = float($4)
  }

intd = dim(outp) 
for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {


          intx = float(1)*outp[inti, intj, intk]
          E = 6.6*1e9*(4.276-0.012*T)

          outp[inti, intj, intk] = (9/4* (1-mu^2)*gamma*pi/(E*intx))^(1.0/3.0)
        }
      }
    }

           return(outp)
}





