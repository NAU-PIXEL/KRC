        part_rad = 8*intx*Fe*sigma*T^3*(1-porosity)*rho*C 
        part_cont = 1.5e-8/intx*Ks*(1-porosity)*rho*C

        outp[inti, intj, intk] = part_rad + part_cont - Inertia^2;
         }
        }
      }




  return(outp)
}













define plot_inverse_Model_GB(0,12){
  if ($ARGC != 12) {
    printf("\nInverse equation to retrieve grain size. Model: GB \n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
     pi = 3.141592653589793
  }
  intd = dim(outp)

  if (type($2) == "double") {
    Inertia = double($2)
  } else {
    Inertia = float($2)
  }
  if (type($3) == "double") {
    T = double($3)
  } else {
    T = float($3)
  }

  if (type($4) == "double") {
    porosity = double($4)
  } else {
    porosity = float($4)
  }

  if (type($5) == "double") {
    rho = double($5)
  } else {
    rho = float($5)
  }

  if (type($6) == "double") {
    C = double($6)
  } else {
    C = float($6)
  }

  if (type($7) == "double") {
    emissivity = double($7)
  } else {
    emissivity = float($7)
  }

  if (type($8) == "double") {
    Ks = double($8)
  } else {
    Ks = float($8)
  }
  if (type($9) == "double") {
    E = double($9)
  } else {
    E = float($9)
  }
  if (type($10) == "double") {
    mu = double($10)
  } else {
    mu = float($10)
  }
  if (type($11) == "double") {
    gamma = double($11)
  } else {
    gamma = float($11)
  }

  if (type($12) == "double") {
    xhi = double($11)
  } else {
    xhi = float($11)
  }




  #Define constant
  sigma = 5.670374e-8
  e_1 = 1.34
  f1 = 5.18e-2
  f2 = 5.26




  # Element-by-element 

for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {

          intx = float(1)*outp[inti, intj, intk]


          Fe = emissivity*e_1*porosity/(1-porosity)

           part_rad = 8*intx*Fe*sigma*T^3*(1-porosity)*rho*C 
          part_cont = 1.5e-8/intx*Ks*(1-porosity)*rho*C


          outp[inti, intj, intk] = part_rad + part_cont - Inertia^2


          }
          }
          }

  return(outp)
}


