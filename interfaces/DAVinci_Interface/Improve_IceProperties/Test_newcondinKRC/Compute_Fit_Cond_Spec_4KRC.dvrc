define Fe_BB_P(Fe0,5){
	if ($ARGC != 5) {
    printf("\nReturns the  factor FE with BB model. Variable is the porosity.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }	


  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
     pi = 3.141592653589793
  }


  if (type($2) == "double") {
    T = double($2)
  } else {
    T = float($2)
  }

  if (type($3) == "double") {
    R = double($3)
  } else {
    R = float($3)
  }

  if (type($4) == "double") {
    emissivity = double($4)
  } else {
    emissivity = float($4)
  }

  #Define constants
  sigma = 5.670374e-8
  flag = int($5) #if flag = 1, crystalline structure 
intd = dim(outp)
# Element-by-element 

for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {


          intx = float(1)*outp[inti, intj, intk]
          B = 1.25*((1-intx)/intx)^(10/9)
          if(flag == 1){
            Ks = K_bulk_crystaline(T)
          } else{
            Ks = K_bulk_amorphous(T)
          }




          Gammaf = Ks/(8*R*sigma*T^3)


          Fe = (1-sqrt(1-intx))*intx + (sqrt(1-intx))/(2/emissivity-1)*(B+1)/B*1/(1+ 1/(Gammaf*(2/emissivity-1)))



          outp[inti, intj, intk] = Fe
        }
      }
    }

           return(outp)
}


