define K_bulk_amorphous(0,1) {

  if ($ARGC != 1) {
    printf("\nReturns the bulk thermal conductivity of an amorphous hexagonal ice\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

