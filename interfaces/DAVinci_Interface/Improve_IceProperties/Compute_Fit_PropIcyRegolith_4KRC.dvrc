define Fe_BB_T(0,5){
  if ($ARGC != 5) {
    printf("\nReturns the  factor FE with BB model. Variable is the temperature.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }

  if (type($2) == "double") {
    porosity = double($2)
  } else {
    porosity = float($2)
  }

  if (type($3) == "double") {
    R = double($3)
  } else {
    R = float($3)
  }

  if (type($4) == "double") {
    emissivity = double($4)
  } else {
    emissivity = float($4)
  }

  #Define constants
  sigma = 5.670374e-8
  flag = int($5) #if flag = 1, crystalline structure
  intd = dim(outp)

  # Element-by-element

  for (intk = 1; intk <= intd[3,1,1]; intk++) {
    for (intj = 1; intj <= intd[2,1,1]; intj++) {
      for (inti = 1; inti <= intd[1,1,1]; inti++) {

        intx = float(1)*outp[inti, intj, intk]
        B = 1.25*((1-porosity)/porosity)^(10/9)
        if(flag == 1){
          Ks = K_bulk_crystaline(intx)
        } else{
          Ks = K_bulk_amorphous(intx)
        }

        Gammaf = Ks/(8*R*sigma*intx^3)

        Fe = (1-sqrt(1-porosity))*porosity + (sqrt(1-porosity))/(2/emissivity[inti,intj,intk]-1)*(B+1)/B*(1/(1+ 1/(Gammaf*(2/emissivity[inti,intj,intk]-1))))

        outp[inti, intj, intk] = Fe
      }
    }
  }

  return(outp)
}

define K_contact_T(0,9){
  if ($ARGC != 9) {
    printf("\nReturns the  Contact conductivity Kc. Variable is the temperature.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }

  if (type($2) == "double") {
    R = double($2)
  } else {
    R = float($2)
  }

  if (type($3) == "double") {
    porosity = double($3)
  } else {
    porosity = float($3)
  }

  if (type($4) == "double") {
    gamma = double($4)
  } else {
    gamma = float($4)
  }

  if (type($5) == "double") {
    mu = double($5)
  } else {
    mu = float($5)
  }

  if (type($6) == "double") {
    xhi = double($6)
  } else {
    xhi = float($6)
  }

  flagh = int($7) #choice of h
  flagphi = int($8) #choice of h
  flagstruct = int($9) #choice of h
  intd = dim(outp)

  # Element-by-element

  for (intk = 1; intk <= intd[3,1,1]; intk++) {
    for (intj = 1; intj <= intd[2,1,1]; intj++) {
      for (inti = 1; inti <= intd[1,1,1]; inti++) {

        intx = float(1)*outp[inti, intj, intk]

        #Conputing h

        if(flagh == 1){
          h = h_JKR_T(intx,gamma,mu,R)
        }
        if(flagh == 2){
          h = h_GB_T(intx,gamma,mu,R)
        }
        if(flagh == 3){
          h = h_W_R(R)
        }

        #Conputing Phi

        if(flagphi == 1){
          Phi = phi_GB_p(porosity,xhi)
        }
        if(flagphi == 2){
          Phi = phi_G_p(porosity)
        }
        if(flagphi == 3){
          Phi = phi_W_p()
        }

        #Conputing Ks

        if(flagstruct == 1){
          Ks = K_bulk_crystaline(intx)
        }
        if(flagstruct == 2){
          Ks = K_bulk_amorphous(intx)
        }

        outp[inti, intj, intk] = h*Phi*Ks

      }
    }
  }

  return(outp)
}

define K_E_T(0,8){
  if ($ARGC != 8) {
    printf("\nReturns the  Effective conductivity Ke. Variable is the temperature.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }

  if (type($2) == "double") {
    R = double($2)
  } else {
    R = float($2)
  }

  if (type($3) == "double") {
    porosity = double($3)
  } else {
    porosity = float($3)
  }

 
  if (type($4) == "double") {
    emissivity = double($4)
  } else {
    emissivity = float($4)
  }

  flagh = int($5) #choice of h
  flagphi = int($6) #choice of phi
  flagrad = int($7)
  flagstruct = int($8)
  intd = dim(outp)


  # Constants based on Ferrari & Lucas (2016) - see their paper for definition-

  gamma = 0.076
  mu = 0.33
  xhi = 0.41

  # Computation of the conductivity Element-by-element

  for (intk = 1; intk <= intd[3,1,1]; intk++) {
    for (intj = 1; intj <= intd[2,1,1]; intj++) {
      for (inti = 1; inti <= intd[1,1,1]; inti++) {

        intx = float(1)*outp[inti, intj, intk]

        #Computing h

        if(flagh == 1){
          h = h_JKR_T(intx,gamma,mu,R)
        }
        if(flagh == 2){
          h = h_GB_T(intx,gamma,mu,R)
        }
        if(flagh == 3){
          h = h_W_R(R)
        }

        #Conputing Phi

        if(flagphi == 1){
          Phi = phi_GB_p(porosity,xhi)
        }
        if(flagphi == 2){
          Phi = phi_G_p(porosity)
        }
        if(flagphi == 3){
          Phi = phi_W_p()
        }

        #Conputing Ks

        if(flagstruct == 1){
          Ks = K_bulk_crystaline(intx)
        }
        if(flagstruct == 2){
          Ks = K_bulk_amorphous(intx)
        }
        #Computing Kr
        if(flagrad == 1){
          Kr = K_rad_BB_T(intx,R,porosity,emissivity[inti,intj,intk],flagstruct)
        }

        if(flagrad == 2){
          Kr = K_rad_GB_T(intx,R,porosity,emissivity[inti,intj,intk],flagstruct)
        }

        outp[inti, intj, intk] = h*Phi*Ks + Kr

      }
    }
  }

  return(outp)
}

define K_rad_BB_T(0,5) {

  if ($ARGC != 5) {
    printf("\nReturns the radiative thermal conductivity for a given radius and porosity. The variable is the temperature\n")
