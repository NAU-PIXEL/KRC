define phi_GB_p(0,2){

  if ($ARGC != 2) {
    printf("\nReturns the  factor phi with GB model. Variable is the porosity.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }	


  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
     pi = 3.141592653589793
  }

  if (type($2) == "double") {
    xhi = double($2)
  } else {
    xhi = float($2)
  }



  #Define constants
  f1 = 5.18e-2
  f2 = 5.26
  intd = dim(outp)

for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {


          intx = float(1)*outp[inti, intj, intk]

          outp[inti, intj, intk] = f1*exp(f2*(1-intx))*xhi
        }
      }
    }

           return(outp)
}




define contact_number(0,1){

  if ($ARGC != 1) {
    printf("\nReturns the  number of contact for a sphere. Variable is the porosity.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }	
  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
     pi = 3.141592653589793
  }


  A = create(2,2,1,format = double)
  A[1,1,1] = 0.26
  A[2,1,1] = 1
  A[1,2,1] = 0.84
  A[2,2,1] = 1

  b = create(1,2,1,format = double)
  b[1,1,1] = 12
  b[1,2,1] = 4

  res = mxm(minvert(A),b)
  alpha = res[1,1,1]
  beta = res[1,2,1]
  intd = dim(outp)
  for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {


          intx = float(1)*outp[inti, intj, intk]

          outp[inti, intj, intk] = (alpha*intx+beta)
        }
      }
    }

           return(outp)
}



define phi_G_p(0,1){

  if ($ARGC != 1) {
    printf("\nReturns the  factor phi with G model. Variable is the porosity.\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }	


  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }

intd = dim(outp)


for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {


          intx = float(1)*outp[inti, intj, intk]

          outp[inti, intj, intk] = (1-intx)*contact_number(intx)/pi
        }
      }
    }
    return(outp)


}



