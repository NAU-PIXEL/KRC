  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }
  intd = dim(outp)

  if (type($2) == "double") {
    R = double($2)
  } else {
    R = float($2)
  }

  if (type($3) == "double") {
    porosity = double($3)
  } else {
    porosity = float($3)
  }

  if (type($4) == "double") {
    emissivity = double($4)
  } else {
    emissivity = float($4)
  }

  #Define constants
  sigma = 5.670374e-8
  flag = int($5) #if flag = 1, crystalline structure
  intd = dim(outp)

  # Element-by-element

  for (intk = 1; intk <= intd[3,1,1]; intk++) {
    for (intj = 1; intj <= intd[2,1,1]; intj++) {
      for (inti = 1; inti <= intd[1,1,1]; inti++) {

        intx = float(1)*outp[inti, intj, intk]
        B = 1.25*((1-porosity)/porosity)^(10/9)
        if(flag == 1){
          Ks = K_bulk_crystaline(intx)
        } else{
          Ks = K_bulk_amorphous(intx)
        }

        Gammaf = Ks/(8*R*sigma*intx^3)

        Fe = (1-sqrt(1-porosity))*porosity + (sqrt(1-porosity))/(2/emissivity[inti,intj,intk]-1)*(B+1)/B*1/(1+ 1/(Gammaf*(2/emissivity[inti,intj,intk]-1)))

        outp[inti, intj, intk] = 8*R*Fe*sigma*intx^3
      }
    }
  }

  return(outp)
}

define K_rad_GB_T(0,5) {

  if ($ARGC != 5) {
    printf("\nReturns the radiative thermal conductivity for a given radius and porosity. The variable is the temperature\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }
  intd = dim(outp)

  if (type($2) == "double") {
    R = double($2)
  } else {
    R = float($2)
  }

  if (type($3) == "double") {
    porosity = double($3)
  } else {
    porosity = float($3)
  }

  if (type($4) == "double") {
    emissivity = double($4)
  } else {
    emissivity = float($4)
  }

  #Define constants
  sigma = 5.670374e-8
  flag = int($5) #if flag = 1, crystalline structure
  e_1 = 1.34
  intd = dim(outp)

  # Element-by-element

  for (intk = 1; intk <= intd[3,1,1]; intk++) {
    for (intj = 1; intj <= intd[2,1,1]; intj++) {
      for (inti = 1; inti <= intd[1,1,1]; inti++) {

        intx = float(1)*outp[inti, intj, intk]
        B = 1.25*((1-porosity)/porosity)^(10/9)
        if(flag == 1){
          Ks = K_bulk_crystaline(intx)
        } else{
          Ks = K_bulk_amorphous(intx)
        }

        Gammaf = Ks/(8*R*sigma*intx^3)

        Fe = e_1*emissivity[inti,intj,intk]*porosity/(1-porosity)

        outp[inti, intj, intk] = 8*R*Fe*sigma*intx^3
      }
    }
  }

  return(outp)
}

define K_bulk_amorphous(0,1) {

  if ($ARGC != 1) {
    printf("\nReturns the bulk thermal conductivity of an amorphous hexagonal ice\n")
    #printf("\n")
    printf("L.Lange 03-16-2020\n\n")

    return(null)
  }

  if (type($1) == "double") {
    outp = double($1)
    pi = atod("3.14159265358979323846"); # This gets around the intermediate float bug
  } else {
    outp = float($1) # Must be float or double for values to be computed accurately
    pi = 3.141592653589793
  }
  intd = dim(outp)

  # Define constants
  rho = 940
  mu = 2500
  lambda = 5*1e-10

  # Element-by-element

  for (intk = 1; intk <= intd[3,1,1]; intk++) {
    for (intj = 1; intj <= intd[2,1,1]; intj++) {
      for (inti = 1; inti <= intd[1,1,1]; inti++) {

        intx = float(1)*outp[inti, intj, intk]
        C_T = Cp_ice_water(intx)

        outp[inti, intj, intk] = C_T*mu*lambda*rho/4
      }
    }
  }

  return(outp)
}

