  }




  if (type($2) == "double") {
    R = double($2)
  } else {
    R = float($2)
  }

  if (type($3) == "double") {
    T = double($3)
  } else {
    T = float($3)
  }

  if (type($4) == "double") {
    gamma = double($4)
  } else {
    gamma = float($4)
  }

  if (type($5) == "double") {
    mu = double($5)
  } else {
    mu = float($5)
  }

  if (type($6) == "double") {
    xhi = double($6)
  } else {
    xhi = float($6)
  }

  if (type($7) == "double") {
    emissivity = double($7)
  } else {
    emissivity = float($7)
  }


  flagh = int($8) #choice of h
  flagphi = int($9) #choice of phi
  flagrad = int($10) #choice of radiative model
  flagstruct = int($11) 
  intd = dim(outp)

  # Element-by-element 

for (intk = 1; intk <= intd[3,1,1]; intk++) {
      for (intj = 1; intj <= intd[2,1,1]; intj++) {
        for (inti = 1; inti <= intd[1,1,1]; inti++) {


          intx = float(1)*outp[inti, intj, intk]



          #Conputing h

          if(flagh == 1){
          h = h_JKR_R(R,gamma,mu,T)
          }
          if(flagh == 2){
          h = h_GB_R(R,gamma,mu,T)
          }
          if(flagh == 3){
          h = h_W_R(R)
          }

          #Conputing Phi

          if(flagphi == 1){
          Phi = phi_GB_p(intx,xhi)
          }
          if(flagphi == 2){
          Phi = phi_G_p(intx)
          }
          if(flagphi == 3){
          Phi = phi_W_p()
          }


          #Computing Ks

          if(flagstruct == 1){
          Ks = K_bulk_crystaline(T)
          rho = 918;
          }
          if(flagstruct == 2){
          Ks = K_bulk_amorphous(T)
          rho = (940);
          }


          #Computing Kr

          if(flagrad == 1){
          Kr = K_rad_BB_P(intx,R,T,emissivity,flagstruct)
          }

          if(flagrad == 2){
          Kr = K_rad_GB_P(intx,R,T,emissivity,flagstruct)
          }


          outp[inti, intj, intk] = sqrt((h*Phi*Ks + Kr)*(1-intx)*rho*Cp_ice_water(T))




        }
      }
    }

           return(outp)
}



