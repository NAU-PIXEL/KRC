          }
          if(flagrad == 2){
          Kr = K_rad_GB_R(intx,porosity,T,emissivity,flagstruct)
          }


          outp[inti, intj, intk] = h*Phi*Ks + Kr




        }
      }
    }

           return(outp)
}












